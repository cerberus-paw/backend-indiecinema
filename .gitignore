# Secretos: se versiona sólo el ejemplo de cada archivo (.env.ejemplo, config.ejemplo.ini).
.env
*/config/config.ini

# Dependencias: se instalan con composer install.
*/vendor/

# Caché de PHPUnit.
.phpunit.result.cache
.phpunit.cache/

# Hand-offs entre sesiones de Claude Code: son locales de cada uno.
.claude/handoff/

# Contexto de trabajo local (no versionado).
.contexto-local/

# La caché del análisis estático (phpstan.neon).
.phpstan/

# Las páginas que guardan las pruebas para el validador del W3C (herramientas/validar-html.sh).
.paginas-para-validar/
