{
    "name": "cerberus-paw/programacion",
    "description": "Subsistema programación de IndieCinema: catálogo, salas, funciones, cartelera, votación de títulos y rankings.",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../nucleo",
            "options": { "versions": { "cerberus-paw/nucleo": "dev-main" } }
        },
        {
            "type": "path",
            "url": "../../frontend-indiecinema",
            "options": { "versions": { "cerberus-paw/frontend-indiecinema": "dev-main" } }
        }
    ],
    "require": {
        "php": "^8.4",
        "cerberus-paw/frontend-indiecinema": "@dev",
        "cerberus-paw/nucleo": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "IndieCinema\\Programacion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndieCinema\\Programacion\\Pruebas\\": "tests/"
        }
    },
    "scripts": {
        "pruebas": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
