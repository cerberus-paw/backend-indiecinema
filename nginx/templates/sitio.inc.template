# El sitio: se atiende igual por HTTP en desarrollo y por HTTPS en el VPS, así que está una sola
# vez y lo incluye el server de servidor-http.inc o el de servidor-https.inc. Los secretos de
# cada subsistema los completa la imagen al arrancar, como en indiecinema.conf.

server_tokens off;
# Redirecciones con la ruta sola (Location: /cuenta/), sin host ni puerto: detrás del puerto
# publicado por Docker (8080) o del HTTPS del VPS, nginx no sabe cuál vio el navegador.
absolute_redirect off;

# Lo que admite PHP (php/php.ini): una imagen de 5 MB más el resto del formulario.
client_max_body_size 6m;

# Al pasarse del límite, 429 Too Many Requests (por defecto sería 503, que dice otra cosa), con
# un mensaje que diga qué hacer: en JSON o en una página, según $formato_del_429.
limit_req_status 429;
error_page 429 /_demasiados/$formato_del_429;

add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options DENY always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
# Content-Security-Policy: el navegador sólo carga scripts, estilos, fuentes, imágenes y pedidos de
# este mismo origen, y nada en línea. Si un texto se escapara del escapado de Twig, el script que
# trajera no corre. El front no usa nada de afuera (la fuente se sirve desde /estaticos/fuentes/)
# ni código o estilos en línea. data: en img-src, por el SVG de la flecha de los <select> de
# estilos.css. Sin upgrade-insecure-requests: en el compose local, que va por HTTP, rompería todo,
# y en el VPS no hace falta porque el HSTS ya obliga HTTPS. Se activó directo, sin pasar por
# Report-Only: el servidor de desarrollo y las pruebas de punta a punta, que fallan con cualquier
# violación, hacen de ensayo.
# Lo que el sitio no usa, apagado: si un script se colara, tampoco podría pedir la cámara, el
# micrófono, la ubicación, un pago ni un USB.
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
# Aislamiento entre orígenes: una ventana de otro sitio abierta desde acá (o que abra ésta) no
# tiene referencia a la otra; otro sitio no puede incrustar nuestras respuestas (las imágenes, el
# JSON); y la página sólo carga lo que lo permite, que es todo lo propio. Las tres las marcó ZAP.
add_header Cross-Origin-Opener-Policy same-origin always;
add_header Cross-Origin-Resource-Policy same-origin always;
add_header Cross-Origin-Embedder-Policy require-corp always;
# Ojo con add_header: un location que tenga uno propio deja de heredar todos estos.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

# Las rutas /interno/ son para la red del compose: desde afuera no existen, con o sin prefijo.
# Es una expresión regular para que gane sobre los prefijos de abajo (que no llevan ^~).
location ~ ^/(cuenta/|funcion/)?interno(/|$) {
    return 404;
}

# El auth_request de cada pedido (subsistema.inc): le pregunta a cuentas de quién es la cookie,
# identificándose como el llamador nginx. «internal»: desde afuera no existe.
location = /_sesion {
    internal;
    set $cuentas cuentas;
    proxy_pass http://$cuentas:8080/interno/sesion;
    proxy_http_version 1.1;
    # Sólo hace falta la cookie: el cuerpo del pedido original no viaja.
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Llamador nginx;
    proxy_set_header Authorization "Bearer ${NGINX_TOKEN_INTERNO}";
    proxy_set_header X-Usuario-Id "";
    proxy_set_header X-Rol "";
    proxy_set_header X-Usuario-Nombre "";
    proxy_set_header X-Nginx-Secreto "";
}

location ^~ /estaticos/ {
    alias /srv/frontend-indiecinema/estaticos/;
    expires 1h;
}

location = /cuenta {
    return 301 /cuenta/;
}
# 5 por minuto por IP con un margen chico: pasan 4 seguidos y después uno cada 12 segundos.
# Expresiones regulares y no «=»: el núcleo atiende igual /ingresar/, con la barra final, y
# con una ruta exacta ese pedido se saltearía el límite. Las barras dobles las une nginx.
location ~ ^/cuenta/ingresar/?$ {
    limit_req zone=ingresar burst=3 nodelay;
    set $subsistema cuentas;
    set $secreto "${NGINX_SECRETO_CUENTAS}";
    rewrite ^/cuenta(/.*)$ $1 break;
    include conf.d/subsistema.inc;
}
location ~ ^/cuenta/registro/?$ {
    limit_req zone=registro burst=3 nodelay;
    set $subsistema cuentas;
    set $secreto "${NGINX_SECRETO_CUENTAS}";
    rewrite ^/cuenta(/.*)$ $1 break;
    include conf.d/subsistema.inc;
}
location /cuenta/ {
    set $subsistema cuentas;
    set $secreto "${NGINX_SECRETO_CUENTAS}";
    rewrite ^/cuenta(/.*)$ $1 break;
    include conf.d/subsistema.inc;
}

location = /funcion {
    return 301 /funcion/;
}
# Reservar una función: 10 por minuto por IP, sólo los POST. Pasan 6 seguidas, que alcanzan para
# el doble clic y para las pruebas de punta a punta, y después una cada 6 segundos. Expresión
# regular por lo mismo que ingresar y registro: con o sin la barra final.
location ~ ^/funcion/reservar/[^/]+/?$ {
    limit_req zone=reserva burst=5 nodelay;
    set $subsistema funciones;
    set $secreto "${NGINX_SECRETO_FUNCIONES}";
    rewrite ^/funcion(/.*)$ $1 break;
    include conf.d/subsistema.inc;
}
location /funcion/ {
    set $subsistema funciones;
    set $secreto "${NGINX_SECRETO_FUNCIONES}";
    rewrite ^/funcion(/.*)$ $1 break;
    include conf.d/subsistema.inc;
}

# La solicitud de sala, de programación. 2 por minuto por IP: pasan 3 seguidos y después uno
# cada 30 segundos.
location ~ ^/solicitar-sala/?$ {
    limit_req zone=solicitud burst=2 nodelay;
    set $subsistema programacion;
    set $secreto "${NGINX_SECRETO_PROGRAMACION}";
    rewrite ^(.*)$ $1 break;
    include conf.d/subsistema.inc;
}

# Los listados con búsqueda de programación: la cartelera, su CSV y las obras. 120 por minuto por
# IP: pasan 61 seguidos y después dos por segundo (el porqué, en indiecinema.conf). No entran la ficha de una función ni sus
# lugares, que la ficha pide cada 15 segundos.
location ~ ^/(cartelera(\.csv)?|obras)/?$ {
    limit_req zone=busqueda burst=60 nodelay;
    set $subsistema programacion;
    set $secreto "${NGINX_SECRETO_PROGRAMACION}";
    rewrite ^(.*)$ $1 break;
    include conf.d/subsistema.inc;
}

# La respuesta del 429 (error_page, arriba). Sin add_header acá: con uno, este location dejaría de
# heredar la CSP y las demás cabeceras. El texto ya dice cuánto esperar, así que va sin
# Retry-After. «internal»: desde afuera no existen.
location = /_demasiados/json {
    internal;
    default_type application/json;
    charset utf-8;
    return 429 '{"error": "Hiciste muchos pedidos seguidos. Probá de nuevo en un minuto."}';
}
location = /_demasiados/html {
    internal;
    default_type text/html;
    charset utf-8;
    return 429 '<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hiciste muchos pedidos seguidos · IndieCinema</title>
<link rel="stylesheet" href="/estaticos/css/estilos.css">
</head>
<body>
<main>
<h1>Hiciste muchos pedidos seguidos</h1>
<p>Hiciste muchos pedidos seguidos. Probá de nuevo en un minuto.</p>
<p><a href="/">Ir al inicio</a></p>
</main>
</body>
</html>
';
}

location / {
    set $subsistema programacion;
    set $secreto "${NGINX_SECRETO_PROGRAMACION}";
    # Sin cambiar nada, para que programación reciba la ruta ya normalizada (sin «..» ni
    # caracteres codificados de más), igual que los otros dos.
    rewrite ^(.*)$ $1 break;
    include conf.d/subsistema.inc;
}
