# IndieCinema: el único punto de entrada. Manda cada prefijo a su subsistema, que recibe la ruta
# sin el prefijo (E2, sección 3), sirve los estáticos del paquete front y no deja llegar desde
# afuera a las rutas /interno/.
#
# Es una plantilla: al arrancar, la imagen de nginx reemplaza las ${NGINX_SECRETO_*} y
# ${NGINX_TOKEN_*} con las de .env (envsubst, con el filtro del compose) y la deja en
# /etc/nginx/conf.d/. Así los secretos no se versionan. Las variables de nginx ($host,
# $subsistema…) no se tocan.
#
# Está en tres partes: acá, lo que vale para todo nginx; en servidor-http.inc o servidor-https.inc,
# quién escucha; y en sitio.inc, el sitio, que es el mismo en los dos casos.

# El DNS de Docker, consultado en cada pedido y no una sola vez al arrancar: si se recrea un
# subsistema (cambia su IP), nginx lo sigue encontrando sin reiniciarse.
resolver 127.0.0.11 valid=10s ipv6=off;

# Límite de intentos contra la fuerza bruta (capa de red): inicio de sesión y registro, por IP.
# Cuentan sólo los POST: abrir o recargar el formulario no gasta intentos. Con la clave vacía
# (cualquier otro método) limit_req no limita. Cada ruta tiene su zona, así fallar al ingresar no
# gasta los intentos de registro. 10 MB alcanzan para unas 160.000 IP.
map $request_method $ip_si_es_post {
    POST $binary_remote_addr;
    default "";
}
limit_req_zone $ip_si_es_post zone=ingresar:10m rate=5r/m;
limit_req_zone $ip_si_es_post zone=registro:10m rate=5r/m;
# La solicitud de sala le manda un correo al equipo: pasan menos, para que no sirva para
# llenarle el buzón.
limit_req_zone $ip_si_es_post zone=solicitud:10m rate=2r/m;
# La reserva de una función: nadie reserva diez veces por minuto, y un script que reserva sin parar
# le pega a funciones y a programación en cada una.
limit_req_zone $ip_si_es_post zone=reserva:10m rate=10r/m;

# Contra el abuso de la búsqueda: muchos listados seguidos desde una IP, cada uno una consulta a la
# base. Cuentan las lecturas, con o sin texto y filtros, porque la cartelera sin filtros también
# consulta. Dos por segundo, con una ráfaga de 60 (sitio.inc): la búsqueda en vivo, el paginado y
# los filtros piden la cartelera muchas veces, y las pruebas de punta a punta, que corren desde una
# sola IP, llegaron a 7 en un segundo y a 89 en 42 segundos. Con la mitad (una por segundo y 30 de
# ráfaga) dos de esas pruebas recibían 429; así usan 9 de los 60.
map $request_method $ip_si_es_lectura {
    GET $binary_remote_addr;
    HEAD $binary_remote_addr;
    default "";
}
limit_req_zone $ip_si_es_lectura zone=busqueda:10m rate=120r/m;

# Con qué responde quien se pasa de un límite (sitio.inc): JSON al JavaScript que lo pide, como el
# formulario de reserva, y una página al navegador.
map $http_accept $formato_del_429 {
    ~application/json json;
    default html;
}

# Quién escucha: en desarrollo, HTTP en el 80; en el VPS, HTTPS en el 443 y el 80 sólo redirige
# (docker-compose.https.yml pone NGINX_SERVIDOR en https). Las dos variantes quedan en conf.d,
# pero nginx lee sólo la que se incluye acá: por eso en desarrollo no hace falta un certificado.
include conf.d/servidor-${NGINX_SERVIDOR}.inc;
