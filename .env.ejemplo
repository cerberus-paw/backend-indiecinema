# Copiar a .env, que no se versiona. Lo lee sólo docker compose: el puerto, las claves de MySQL y
# los secretos de nginx.
# La clave de cada usuario de base va acá (para crearlo) y en el config.ini de su subsistema
# (para conectarse): si se cambia una, hay que cambiar la otra.

# En el VPS, 80 (HTTPS lo termina nginx con su propia configuración).
PUERTO_HTTP=8080

MYSQL_CLAVE_ROOT=cambiar
MYSQL_CLAVE_MIGRACIONES=cambiar
MYSQL_CLAVE_CUENTAS=cambiar
MYSQL_CLAVE_PROGRAMACION=cambiar
MYSQL_CLAVE_FUNCIONES=cambiar

# El secreto que nginx manda a cada subsistema en X-Nginx-Secreto: el mismo que [nginx] secreto
# del config.ini de ese subsistema, y distinto para cada uno. Uno largo y al azar, sin comillas
# ni «$»: openssl rand -hex 32
NGINX_SECRETO_CUENTAS=cambiar
NGINX_SECRETO_PROGRAMACION=cambiar
NGINX_SECRETO_FUNCIONES=cambiar
# El token con el que nginx llama a /interno/sesion de cuentas: su SHA-256 va en [llamadores]
# nginx del config.ini de cuentas.
NGINX_TOKEN_INTERNO=cambiar
