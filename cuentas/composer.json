{
    "name": "cerberus-paw/cuentas",
    "description": "Subsistema cuentas de IndieCinema: registro, sesión, roles, perfil y seguidos.",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../nucleo",
            "options": { "versions": { "cerberus-paw/nucleo": "dev-main" } }
        },
        {
            "type": "path",
            "url": "../../frontend-indiecinema",
            "options": { "versions": { "cerberus-paw/frontend-indiecinema": "dev-main" } }
        }
    ],
    "require": {
        "php": "^8.4",
        "cerberus-paw/frontend-indiecinema": "@dev",
        "cerberus-paw/nucleo": "@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "IndieCinema\\Cuentas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndieCinema\\Cuentas\\Pruebas\\": "tests/",
            "IndieCinema\\Nucleo\\Pruebas\\Dobles\\": "../nucleo/tests/Dobles/",
            "IndieCinema\\Nucleo\\Pruebas\\Csrf\\": "../nucleo/tests/Csrf/"
        }
    },
    "scripts": {
        "pruebas": "phpunit",
        "analisis": "phpstan analyse --memory-limit=1G --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
