parameters:
	ignoreErrors:
		-
			message: '#^Using nullsafe property access "\?\-\>accion" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Aplicacion.php

		-
			message: '#^Using nullsafe property access "\?\-\>patron" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Aplicacion.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: src/BaseDeDatos.php

		-
			message: '#^Using nullsafe property access "\?\-\>rolMinimo" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Seguridad/ControlDeAcceso.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 2
			path: tests/BaseDeDatosTest.php
