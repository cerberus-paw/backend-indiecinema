# Copiar a .env, que no se versiona. Lo lee sólo docker compose: el puerto y las claves de MySQL.
# La clave de cada usuario de base va acá (para crearlo) y en el config.ini de su subsistema
# (para conectarse): si se cambia una, hay que cambiar la otra.

# En el VPS, 80 (HTTPS lo termina nginx con su propia configuración).
PUERTO_HTTP=8080

MYSQL_CLAVE_ROOT=cambiar
MYSQL_CLAVE_MIGRACIONES=cambiar
MYSQL_CLAVE_CUENTAS=cambiar
MYSQL_CLAVE_PROGRAMACION=cambiar
