# Lo común a los tres subsistemas. Va en un archivo aparte porque, si una location define una
# sola cabecera propia, deja de heredar todas las del server. Cada location pone antes
# $subsistema y $secreto, el que nginx comparte con ese subsistema.

# Cada pedido pasa primero por cuentas, que valida la cookie de sesión (/interno/sesion). Siempre
# responde 200: sin sesión, con las cabeceras vacías, y las páginas públicas siguen andando; las
# privadas las rechaza el subsistema según el rol de la ruta.
auth_request /_sesion;
auth_request_set $sesion_usuario_id $upstream_http_x_usuario_id;
auth_request_set $sesion_rol $upstream_http_x_rol;
auth_request_set $sesion_nombre $upstream_http_x_usuario_nombre;

# Con el nombre en una variable, se resuelve en cada pedido (ver «resolver»). Apache escucha en
# el 8080 porque corre sin privilegios (php/Dockerfile).
proxy_pass http://$subsistema:8080;
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-Proto $scheme;

# La identidad la pone sólo nginx: estas reemplazan a las que mande el navegador, y una cabecera
# vacía no se envía. El subsistema les cree sólo si llega también su secreto (Identificacion del
# núcleo), así desde la red interna nadie puede hacerse pasar por otro sin él.
proxy_set_header X-Usuario-Id $sesion_usuario_id;
proxy_set_header X-Rol $sesion_rol;
proxy_set_header X-Usuario-Nombre $sesion_nombre;
proxy_set_header X-Nginx-Secreto $secreto;
# Sólo los usa el auth_request: que no lleguen desde el navegador a ningún subsistema.
proxy_set_header X-Llamador "";
proxy_set_header Authorization "";
